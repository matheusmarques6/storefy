{
  "name": "@storefy/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir .expo/export-android && expo export --platform ios --output-dir .expo/export-ios",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "start": "expo start --dev-client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@storefy/bridge": "workspace:*",
    "@storefy/config-schema": "workspace:*",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-updates": "~57.0.23",
    "onesignal-expo-plugin": "^2.7.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-onesignal": "^5.5.11",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
