{
  "name": "storefy",
  "version": "0.0.0",
  "private": true,
  "description": "Storefy by Convertfy \u2014 transforma lojas Shopify em apps iOS e Android.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "test:rls": "./scripts/test-rls.sh",
    "e2e": "pnpm --filter @storefy/web run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:types": "tsx scripts/gen-db-types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pg": "^8.23.0",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.20.6",
    "turbo": "^2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
