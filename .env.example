# =============================================================================
# Storefy — variáveis de ambiente
#
# Copie este arquivo para `apps/web/.env.local` e preencha:
#
#     cp .env.example apps/web/.env.local
#
# O destino é `apps/web/`, e NÃO a raiz. O Next carrega os arquivos `.env*` ao
# lado do próprio app; deixado na raiz do monorepo, ele não os enxerga e a
# aplicação sobe mostrando "Configuração pendente". Os scripts da raiz
# (`bootstrap:admin`, `db:types`) procuram em `apps/web/` primeiro.
#
# `.env.local` está no .gitignore e nunca deve ser versionado.
#
# A Fase 0 precisa apenas do bloco SUPABASE. O resto está aqui documentado
# desde já para você saber o que cada fase vai pedir; deixe em branco até lá.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — obrigatório na Fase 0
# -----------------------------------------------------------------------------

# URL da API do seu projeto. Painel do Supabase > Project Settings > Data API.
# Formato: https://<ref-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon / publishable). Vai para o browser — é seguro expor,
# porque quem protege os dados é a RLS, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role. IGNORA A RLS: nunca coloque em variável NEXT_PUBLIC_,
# nunca envie ao browser, nunca comite. Usada só por Server Actions e Route
# Handlers que já validaram platform_admins, e pelo `pnpm bootstrap:admin`.
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão do Postgres. Usada por `pnpm db:types` e `pnpm test:rls`
# quando você aponta para um banco remoto. Para o cluster local, pode deixar
# em branco (o padrão já aponta para localhost).
# PGURL=postgres://postgres:senha@127.0.0.1:5432/storefy_local

# -----------------------------------------------------------------------------
# APLICAÇÃO — obrigatório em produção
# -----------------------------------------------------------------------------

# URL pública do painel, sem barra no final. É o destino dos links de
# confirmação de e-mail e recuperação de senha. Em desenvolvimento:
# http://app.localhost:3000. Na Vercel, se não preencher, usa VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Domínios próprios dos painéis. Deixe em branco enquanto usar o domínio da
# Vercel: sem eles, o admin responde em /admin no mesmo host. Preenchendo,
# o middleware passa a rotear por subdomínio e /admin redireciona para lá.
# Exemplos: storefy.convertfy.me e admin-storefy.convertfy.me
NEXT_PUBLIC_CLIENT_HOST=
NEXT_PUBLIC_ADMIN_HOST=

# Mostra o botão "Entrar com Google". Só ligue depois de configurar o provedor
# Google no Supabase (Authentication > Providers). Com "false" ou em branco, o
# botão aparece desabilitado explicando que falta configurar.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Chave AES-GCM de 32 bytes em base64, para criptografar os segredos das lojas
# (token Shopify, chaves OneSignal e Apple). Gere com:
#   openssl rand -base64 32
# Só é usada a partir da Fase 4; deixe em branco até lá.
ENCRYPTION_KEY=

# E-mail do primeiro administrador da plataforma, usado por
# `pnpm bootstrap:admin` quando você não passa o e-mail como argumento.
BOOTSTRAP_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# E-MAIL (Resend) — Fase 0 opcional, recomendado antes de convidar usuários
# -----------------------------------------------------------------------------

# Chave da API do Resend.
#
# ATENÇÃO: a aplicação NÃO lê esta variável na Fase 0. O Resend entra como SMTP
# dentro do Supabase (Authentication > Emails > SMTP Settings), não pelo código.
# Cadastrá-la na Vercel agora não liga nada; ela passa a ter uso na Fase 3,
# quando o painel enviar e-mail transacional direto.
#
# O Supabase tem um SMTP próprio com limite baixo,
# suficiente para testar; para uso real, configure o Resend como SMTP
# customizado no painel do Supabase:
#   Host: smtp.resend.com   Porta: 465   Usuário: resend   Senha: esta chave
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# ONESIGNAL — Fase 3 (push notifications)
# -----------------------------------------------------------------------------

# Organization API Key da OneSignal. É com ela que a Storefy cria um app
# OneSignal por loja, já com as credenciais APNs e FCM do cliente.
ONESIGNAL_ORG_API_KEY=

# -----------------------------------------------------------------------------
# BUILD E PUBLICAÇÃO — Fase 4
# -----------------------------------------------------------------------------

# Token do GitHub com escopo repo, para disparar o workflow de build por
# repository_dispatch, e o repositório alvo no formato dono/repo.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=

# Token de robô do Expo (EAS), para criar projetos e disparar builds por loja.
# Esta vai nos SEGREDOS DO GITHUB, não na Vercel: quem a usa é o runner.
EXPO_TOKEN=

# Conta ou organização dona dos projetos no Expo (o slug que aparece na URL do
# painel do Expo). Vai nos SEGREDOS DO GITHUB. É opcional: com um token de
# conta pessoal o EAS resolve sozinho. Com um token que enxerga mais de uma
# organização, ele PARA esperando a resposta — e num runner não há ninguém
# para responder.
#
# O slug do projeto de cada loja NÃO é configuração: ele é derivado do id da
# loja (`slugDoProjeto`, em `apps/web/lib/build-interno.ts`) e chega ao runner
# pela rota interna do build. Um slug fixo faria a segunda loja a publicar
# entrar no projeto EAS da primeira, e as duas dividiriam o canal de update.
EXPO_OWNER=

# Segredo que o workflow do GitHub usa para falar com as rotas internas
# (/api/internal/build e /api/internal/ota). Precisa estar nos DOIS lugares —
# na Vercel, para a rota conferir, e nos segredos do GitHub, para o runner
# assinar. Gere com: openssl rand -hex 32
BUILD_API_SECRET=

# Endereço público do painel, como o runner do GitHub o alcança. Vai nos
# SEGREDOS DO GITHUB. Ex.: https://app.storefy.com.br
STOREFY_API_URL=

# Segredo compartilhado que assina os webhooks do EAS, para validar que o
# status de build veio mesmo da Expo. Gere com: openssl rand -hex 32
#
# Precisa estar nos DOIS lugares, como o BUILD_API_SECRET — na Vercel, para a
# rota conferir, e nos SEGREDOS DO GITHUB, porque o webhook do EAS é POR
# PROJETO e cada loja tem o seu: é o workflow de build que o registra, com
# este valor, no projeto novo de cada loja. Registrar à mão não escala, e um
# projeto sem webhook gera o binário e nunca avisa — a tela do lojista diria
# "gerando" para sempre.
#
# Sem ele, /api/webhooks/eas responde 503 de propósito: aceitar POST sem
# conferir assinatura deixaria qualquer um marcar um build como aprovado.
EAS_WEBHOOK_SECRET=

# NÃO PREENCHA ESTAS AQUI. Elas existem só para documentar o contrato: são os
# nomes que `apps/mobile/eas.json` interpola com `$`, e quem as define é o
# runner do GitHub Actions, a partir das credenciais que o lojista conectou no
# painel. Cada loja publica na conta de desenvolvedor do próprio cliente
# (diretriz 4.2.6 da Apple), então elas mudam a cada build e nunca são
# configuração do nosso ambiente.
#   EXPO_ASC_API_KEY_PATH, EXPO_ASC_KEY_ID, EXPO_ASC_ISSUER_ID,
#   EXPO_APPLE_TEAM_ID, EXPO_GOOGLE_SERVICE_ACCOUNT_PATH

# -----------------------------------------------------------------------------
# E-MAIL TRANSACIONAL — Fase 4
# -----------------------------------------------------------------------------

# A chave da Resend já está no bloco de e-mail acima. Sem ela o aviso de "app
# aprovado" NÃO é descartado: volta para a fila e sai no ciclo seguinte.
#
# Remetente verificado na Resend, no formato "Nome <endereco@dominio>". O
# domínio precisa estar verificado lá, senão a Resend recusa com 403.
EMAIL_REMETENTE=

# -----------------------------------------------------------------------------
# JOBS AGENDADOS — Fase 3
# -----------------------------------------------------------------------------

# Segredo enviado no header pelo Vercel Cron. As rotas de job recusam qualquer
# chamada sem ele, senão qualquer pessoa dispararia envio de push.
CRON_SECRET=

# NÃO EXISTE variável de segredo do app mobile, e isso é de propósito: cada
# app tem o SEU, gerado no primeiro build e guardado cifrado em
# `apps.device_secret_enc`. Um segredo único para todos significaria que vazar
# o binário de um cliente abriria os endpoints de todos os outros.

# -----------------------------------------------------------------------------
# SHOPIFY — Fase 5
# -----------------------------------------------------------------------------

# Credenciais do app Shopify criado no Partner Dashboard, e os escopos pedidos
# no OAuth.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_fulfillments

# -----------------------------------------------------------------------------
# COBRANÇA — Fase 7
# -----------------------------------------------------------------------------

# Use Asaas (cartão e Pix, Brasil) ou Stripe. Preencha apenas o escolhido.
ASAAS_API_KEY=
STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# OBSERVABILIDADE — Fase 8
# -----------------------------------------------------------------------------

# DSN do Sentry, para erros de web e mobile.
SENTRY_DSN=
